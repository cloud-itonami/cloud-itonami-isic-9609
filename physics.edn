;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a document-courier robot assists physical record
;; handoff for personal-service businesses (ISIC 9609), gated by the Personal
;; Service Governor. Its physical work is carrying client record boxes along
;; shared corridors where people walk, and placing each box in the secure
;; handoff locker.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-9609"
 :cases
 [{:id :record-courier-shared-corridor
   :kind :transport
   :procedure "courier robot carries a client record box along a shared corridor and must stop short when a person steps out in front of it; the sweep is its cruise-speed setting"
   :params {:mass-kg 35.0 :payload-kg 8.0 :distance-m 50.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.0 :drive-force-n 120.0 :crr 0.02
            :cog-height-m 0.45 :support-half-length-m 0.22
            :max-time-s 1200.0}
   :sweep {:param :v-max-mps :values [0.6 0.8 1.0 1.2 1.4 1.6]}
   :quantity :stopping-distance-m
   :limit {:max 0.5 :basis "estimate: stop within half a metre from cruise speed when a person steps into the corridor"}
   :boundary {:lo 0.3 :hi 2.5}}
  {:id :box-into-handoff-locker
   :kind :manipulator
   :procedure "arm lifts the sealed record box from the robot deck into the upper compartment of the secure handoff locker"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 3.0
            :from [0.50 0.10] :to [0.30 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 3.0 5.0 7.0 9.0 11.0]}
   :quantity :peak-tau1-nm
   :limit {:max 80.0 :basis "estimate: continuous shoulder torque of a 7 kg-class collaborative arm"}
   :boundary {:lo 0.2 :hi 30.0}}]}
